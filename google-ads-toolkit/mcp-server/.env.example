# Copie este arquivo para .env e preencha. O .env NUNCA deve ser versionado
# nem colado em conversa com o Claude — ele contem credenciais.

# --- Credenciais da API (obrigatorias) ---
# Developer token: no MCC, em Ferramentas > Configuracao > Central de API
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth client: Google Cloud Console > APIs e servicos > Credenciais
# Crie um "ID do cliente OAuth" do tipo "App para computador"
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Refresh token: gerado uma unica vez com `python gerar_refresh_token.py`
GOOGLE_ADS_REFRESH_TOKEN=

# --- Contas ---
# ID do MCC, sem hifens. Obrigatorio se voce acessa contas atraves de um MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Conta padrao a gerenciar, sem hifens. Opcional: pode ser passada em cada chamada.
GOOGLE_ADS_CUSTOMER_ID=

# --- Seguranca ---
# false = somente leitura (padrao e recomendado para o primeiro teste).
# true  = habilita as ferramentas de escrita. Mesmo assim, toda mutacao
#         continua exigindo aprovacao explicita sua no chat, e roda em
#         dry_run por padrao.
GOOGLE_ADS_ALLOW_WRITE=false
